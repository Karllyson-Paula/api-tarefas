# Copie este arquivo para .env e preencha com os seus valores.
# O arquivo .env real NÃO deve ir para o Git.

# Banco local (desenvolvimento)
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/api_tarefas?schema=public"

# Em produção, use a connection string direta do Neon, com SSL:
# DATABASE_URL="postgresql://USUARIO:SENHA@HOST.neon.tech/NOME_DO_BANCO?sslmode=require"

# Segredo usado para assinar os tokens JWT (obrigatório em produção)
JWT_SECRET="troque-por-um-valor-longo-e-aleatorio"
