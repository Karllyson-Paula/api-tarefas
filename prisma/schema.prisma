generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      =  env("DATABASE_URL")
}

model Usuario {
  id       Int        @id @default(autoincrement())
  nome     String
  email    String     @unique
  senha    String
  tarefas  Tarefa[]
  criadoEm DateTime   @default(now())
}

model Tarefa {
  id         Int          @id @default(autoincrement())
  titulo     String
  concluida  Boolean      @default(false)
  Usuario    Usuario      @relation(fields: [usuarioId], references: [id])
  usuarioId  Int
  criadoEm   DateTime     @default(now())
}